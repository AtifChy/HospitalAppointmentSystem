@model BLL.DTOs.AppointmentDto
@{
    ViewData["Title"] = "View Prescription";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4>Prescription Details</h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5>Patient Information</h5>
                        <hr/>
                        <dl>
                            <dt>Patient Name</dt>
                            <dd>@Model.PatientName</dd>

                            <dt>Date</dt>
                            <dd>@Model.Date.ToLongDateString()</dd>
                        </dl>
                        <h5>Doctor Information</h5>
                        <hr/>
                        <dl>
                            <dt>Doctor Name</dt>
                            <dd>@Model.DoctorName</dd>

                            <dt>Department</dt>
                            <dd>@Model.Department</dd>
                        </dl>
                        <h5>Medication Details</h5>
                        <hr/>
                        <dl>
                            <dt>Medication</dt>
                            <dd>@Model.Prescription?.Medication</dd>

                            <dt>Dosage</dt>
                            <dd>@Model.Prescription?.Dosage</dd>

                            <dt>Instructions</dt>
                            <dd>@Model.Prescription?.Instruction</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="card-footer text-end">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
