@model BLL.DTOs.PrescriptionDto

@{
    ViewData["Title"] = "Add Prescription";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5>
                    Prescription for @ViewBag.PatientName
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="AddPrescription" method="post">
                    <input asp-for="AppointmentId" type="hidden">

                    <div class="mb-3">
                        <label asp-for="Medication" class="form-label"></label>
                        <input asp-for="Medication" class="form-control" placeholder="e.g. Paracetamol">
                        <span asp-validation-for="Medication" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dosage" class="form-label"></label>
                        <input asp-for="Dosage" class="form-control" placeholder="e.g. 1 tablet 3 times daily">
                        <span asp-validation-for="Dosage" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Instruction" class="form-label"></label>
                        <textarea asp-for="Instruction" class="form-control" rows="4"
                                  placeholder="e.g. Take after meals and finish full course"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>