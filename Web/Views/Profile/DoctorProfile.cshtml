@model BLL.DTOs.DoctorDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
        }
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">My Profile (Doctor)</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Full Name:</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Department:</dt>
                    <dd class="col-sm-8">@Model.DepartmentName</dd>

                    <dt class="col-sm-4">License Number:</dt>
                    <dd class="col-sm-8">@Model.LicenseNumber</dd>

                    <dt class="col-sm-4">Consultation Fee:</dt>
                    <dd class="col-sm-8">$@Model.Fee</dd>

                    <dt class="col-sm-4">Gender:</dt>
                    <dd class="col-sm-8">@(Model.Gender ?? "Not Specified")</dd>

                    <dt class="col-sm-4">Phone Number:</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "Not Specified")</dd>

                    <dt class="col-sm-4">Date of Birth:</dt>
                    <dd class="col-sm-8">@Model.DateOfBirth.ToShortDateString()</dd>

                    <dt class="col-sm-4">Availability:</dt>
                    <dd class="col-sm-8">@Model.IsAvailable</dd>
                </dl>
            </div>
            <div class="card-footer text-end">
                <a asp-action="Edit" class="btn btn-success">Edit</a>
            </div>
        </div>
    </div>
</div>
"