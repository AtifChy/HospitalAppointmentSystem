@model BLL.DTOs.AdminDto
@{
    ViewData["Title"] = "Delete Admin";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Admin</h4>
            </div>
            <div class="card-body">
                <p class="lead text-center mb-4">Are you sure you want to delete this admin?</p>
                
                <div class="row mb-3">
                    <div class="col-4 fw-bold">Name:</div>
                    <div class="col-8">@Model.Name</div>
                </div>
                <div class="row mb-3">
                    <div class="col-4 fw-bold">Email:</div>
                    <div class="col-8">@Model.Email</div>
                </div>
                <div class="row mb-3">
                    <div class="col-4 fw-bold">Phone:</div>
                    <div class="col-8">@Model.PhoneNumber</div>
                </div>

                <form asp-action="DeleteConfirmed" method="post" class="text-center mt-4">
                    <input type="hidden" asp-for="Id"/>
                    <a asp-action="Index" class="btn btn-secondary px-4 me-2">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
