@model BLL.DTOs.DoctorDto
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <h5><i class="bi bi-person-badge"></i> Doctor Details</h5>
                <span class="badge bg-@(Model.IsAvailable ? "success" : "secondary") align-self-center">
                    @(Model.IsAvailable ? "Available" : "Unavailable")
                </span>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.DepartmentName</dd>

                    <dt class="col-sm-4">License No.</dt>
                    <dd class="col-sm-8">@Model.LicenseNumber</dd>

                    <dt class="col-sm-4">Consultation Fee</dt>
                    <dd class="col-sm-8">@Model.Fee</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Back
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>
        </div>
    </div>
</div>