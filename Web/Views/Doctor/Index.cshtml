@model List<BLL.DTOs.DoctorDto>
@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Doctors</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Doctor</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Phone</th>
                    <th>License</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        <td>@doctor.Name</td>
                        <td>@doctor.Email</td>
                        <td>@doctor.DepartmentName</td>
                        <td>@doctor.PhoneNumber</td>
                        <td>@doctor.LicenseNumber</td>
                        <td>@doctor.Fee.ToString("C")</td>
                        <td>
                            <span class="badge @(doctor.IsAvailable ? "bg-success" : "bg-danger")">
                                @(doctor.IsAvailable ? "Available" : "Not Available")
                            </span>
                        </td>
                        <td class="w-25">
                            <a asp-action="Edit" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center">No doctors found.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
