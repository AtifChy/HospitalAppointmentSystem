@model DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container-fluid">
    <h2 class="mb-4">Doctor Dashboard</h2>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card bg-info text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Total Appointments</h5>
                    <h2 class="card-text">@Model.TotalAppointments</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body">
                    <h5 class="card-title">Pending</h5>
                    <h2 class="card-text">@Model.PendingAppointments</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Confirmed</h5>
                    <h2 class="card-text">@Model.ConfirmedAppointments</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Today</h5>
                    <h2 class="card-text">@Model.TodayAppointments</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Upcoming Appointments</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Status</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var app in Model.UpcomingAppointments)
                            {
                                <tr>
                                    <td>@app.Date.ToShortDateString()</td>
                                    <td>@app.TimeSlot</td>
                                    <td>@app.PatientName</td>
                                    <td>
                                            <span
                                                class="badge @(app.Status == "Confirmed" ? "bg-success" : app.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                                @app.Status
                                            </span>
                                    </td>
                                </tr>
                            }
                            @if (!Model.UpcomingAppointments.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center">No upcoming appointments</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>