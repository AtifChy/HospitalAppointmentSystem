@model PatientDashboardViewModel
@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="container-fluid">
    <h2 class="mb-4">Patient Dashboard</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card bg-info text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Total Appointments</h5>
                    <h2 class="card-text">@Model.TotalAppointments</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body">
                    <h5 class="card-title">Pending</h5>
                    <h2 class="card-text">@Model.PendingAppointments</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Completed</h5>
                    <h2 class="card-text">@Model.CompletedAppointments</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end">
        <a asp-controller="Appointment" asp-action="Book" class="btn btn-primary shadow">
            + Book New Appointment
        </a>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Upcoming Appointments</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Doctor</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var app in Model.UpcomingAppointments)
                            {
                                <tr>
                                    <td>@app.Date.ToShortDateString()</td>
                                    <td>@app.TimeSlot</td>
                                    <td>@app.DoctorName</td>
                                    <td>@app.Department</td>
                                    <td>
                                        <span
                                            class="badge @(app.Status == "Confirmed" ? "bg-success" : app.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                            @app.Status
                                        </span>
                                    </td>
                                    <td class="w-auto">
                                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@app.PatientId"
                                           class="btn btn-sm btn-outline-info" title="Patient Details">👁️</a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.UpcomingAppointments.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center">No upcoming appointments</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>