@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4">Admin Dashboard</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <h5 class="card-title">Total Doctors</h5>
                <h2 class="card-text">@Model.TotalDoctors</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <h5 class="card-title">Total Patients</h5>
                <h2 class="card-text">@Model.TotalPatients</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-info text-white shadow">
            <div class="card-body">
                <h5 class="card-title text-truncate">Total Appointments</h5>
                <h2 class="card-text">@Model.TotalAppointments</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-warning text-dark shadow">
            <div class="card-body">
                <h5 class="card-title">Pending</h5>
                <h2 class="card-text">@Model.PendingAppointments</h2>
            </div>
        </div>
    </div>
</div>

@if (Model.PendingAppointments > 0)
{
    <div class="alert alert-warning">
        <strong>Warning:</strong> @Model.PendingAppointments pending appointments.
        <a href="" class="alert-link">Review now</a>
    </div>
}

<div class="card shadow">
    <div class="card-header">
        <h5>Recent Appointments</h5>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var app in Model.RecentAppointments)
            {
                <tr>
                    <td>@app.Date.ToShortDateString()</td>
                    <td>@app.TimeSlot</td>
                    <td>@app.PatientName</td>
                    <td>@app.DoctorName</td>
                    <td>
                        <span
                            class="badge @(app.Status == "Confirmed" ? "bg-success" : app.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                            @app.Status
                        </span>
                    </td>
                </tr>
            }
            @if (!Model.RecentAppointments.Any())
            {
                <tr>
                    <td colspan="5" class="text-center">No recent appointments</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
