@model List<BLL.DTOs.PatientDto>
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Patients</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Patient</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Blood Group</th>
                    <th>Emergency Contact</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>@patient.Name</td>
                        <td>@patient.Email</td>
                        <td>@patient.PhoneNumber</td>
                        <td>@patient.BloodGroup</td>
                        <td>@patient.EmergencyContact</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary"
                               title="Edit">
                                📝
                            </a>
                            <form asp-action="MarkForPasswordChange" asp-route-id="@patient.Id" method="post"
                                  class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                        title="Mark for password change">
                                    🔑
                                </button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-danger"
                               title="Delete">
                                🗑️
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center">No patients found.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
